{
  "name": "rpg-core",
  "version": "0.1.0",
  "description": "A ludematic core: open-ended game rulesets as pure data, played by one generic runtime.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "scripts": {
    "test": "tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsc --noEmit && node --experimental-strip-types --no-warnings scripts/validate.ts && vitest run",
    "play": "node --experimental-strip-types --no-warnings scripts/play.ts",
    "sim": "node --experimental-strip-types --no-warnings scripts/sim.ts",
    "browser": "node --experimental-strip-types --no-warnings scripts/browser.ts"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "^8.0.0",
    "ajv": "^8.17.1",
    "immer": "^10.1.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
