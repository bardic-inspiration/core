{
  "name": "core",
  "version": "1.0.0",
  "private": true,
  "description": "A ludematic core: open-ended game rulesets as pure data, played by one generic runtime.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "main": "src/index.ts",
  "scripts": {
    "test": "tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node --experimental-strip-types --no-warnings scripts/check.ts && vitest run",
    "play": "node --experimental-strip-types --no-warnings scripts/play.ts",
    "sim": "node --experimental-strip-types --no-warnings scripts/sim.ts",
    "browser": "node --experimental-strip-types --no-warnings scripts/browser.ts"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "^8.0.0",
    "ajv": "^8.17.1",
    "immer": "^11.2.10",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
